#/ This script shows the breakdown details on data cleaning and standardization for crm_cust_info /#

SELECT TOP (1000) [cst_id]
      ,[cst_key]
      ,[cst_firstname]
      ,[cst_lastname]
      ,[cst_material_status]
      ,[cst_gender]
      ,[cst_create_date]
  FROM [DataWarehouse].[bronze].[crm_cust_info]


 --to detect duplicate in primary key
  SELECT 
  cst_id,
  COUNT (*)
  FROM bronze.crm_cust_info
  GROUP BY cst_id
  HAVING COUNT (*) >1 OR cst_id IS NULL;

--Few & missing cst_id shows duplicates >1, thus need to do data cleansing

-- to remove duplicates cst_id by doing ranking based on latest cst_create_date and also filter NULL cst id
SELECT 
*
FROM (
SELECT *,
ROW_NUMBER () OVER (PARTITION BY cst_id ORDER BY cst_create_date DESC) as flag_last
FROM bronze.crm_cust_info
WHERE cst_id IS NOT NULL
)t 
WHERE flag_last = 1

--Check for unwanted spaces
-- Expectation : No Results
SELECT *
FROM bronze.crm_cust_info;

--cst_firstname shows no spaces
SELECT cst_firstname
FROM bronze.crm_cust_info
WHERE cst_firstname != TRIM (cst_firstname);

--cst_lastname shows no spaces
SELECT cst_lastname
FROM bronze.crm_cust_info
WHERE cst_lastname != TRIM (cst_lastname);

--cst_marital_status shows no spaces
SELECT cst_marital_status
FROM bronze.crm_cust_info
WHERE cst_marital_status != TRIM (cst_marital_status);

-- cst_gndr shows no spaces
SELECT cst_gndr
FROM bronze.crm_cust_info
WHERE cst_gndr != TRIM (cst_gndr);

-- to trim cst_firstname & cst_lastname with no spaces

SELECT 
cst_id,
cst_key,
TRIM (cst_firstname) AS cst_firstname,
TRIM (cst_lastname) AS cst_lastname,
cst_marital_status,
cst_gndr,
cst_create_date
FROM (
SELECT
*,
ROW_NUMBER () OVER (PARTITION BY cst_id ORDER BY cst_create_date DESC) as flag_last
FROM bronze.crm_cust_info
WHERE cst_id IS NOT NULL
)t 
WHERE flag_last = 1

-- Data Standardization & Consistency
--cst_gndr shows F, M and NULL
SELECT DISTINCT cst_gndr
FROM bronze.crm_cust_info;

--cst_marital_status shows S, M and NULL
SELECT DISTINCT cst_marital_status
FROM bronze.crm_cust_info;

-- standardize gender F as Female, M as male, NULL as n/a
--standardize marital status S as Single, M as Married, NULL as n/a
SELECT 
cst_id,
cst_key,
TRIM (cst_firstname) AS cst_firstname,
TRIM (cst_lastname) AS cst_lastname,
CASE WHEN UPPER (TRIM(cst_marital_status)) = 'M' THEN 'Married'
    WHEN UPPER (TRIM (cst_marital_status)) = 'S' THEN 'Single'
    ELSE 'n/a'
    END cst_marital_status,
CASE WHEN UPPER (TRIM(cst_gndr)) = 'F' THEN 'Female'
    WHEN UPPER (TRIM (cst_gndr)) = 'M' THEN 'Male'
    ELSE 'n/a'
    END cst_gndr,
cst_create_date
FROM (
SELECT 
*,
ROW_NUMBER () OVER (PARTITION BY cst_id ORDER BY cst_create_date DESC) as flag_last
FROM bronze.crm_cust_info
WHERE cst_id IS NOT NULL
)t 
WHERE flag_last = 1

