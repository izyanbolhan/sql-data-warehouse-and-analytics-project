FROM bronze.crm_prd_info

-- Data Standardization & Consistency
--cst_gndr shows M,R,S,T and NULL
SELECT DISTINCT prd_line
FROM bronze.crm_prd_info

-- to replace prd_line name abv into 
SELECT
prd_id,
prd_key,
REPLACE (SUBSTRING (prd_key,1,5),'-','_') AS cat_id,
SUBSTRING (prd_key,7, LEN (prd_key)) AS prd_key,
prd_nm,
ISNULL (prd_cost,0) AS prd_cost,
CASE UPPER (TRIM(prd_line))  -- to simplify QUICK CASE for simple value mapping
WHEN 'M' THEN 'Mountain'
WHEN 'R' THEN 'Road'
WHEN 'S' THEN 'Other Sales'
WHEN 'T' THEN 'Touring'
ELSE 'n/a'
END prd_line,
prd_start_dt,
prd_end_dt
FROM bronze.crm_prd_info

--Check for Invalid Date Orders
--end date must not be earlier than the start date
SELECT *
FROM bronze.crm_prd_info
WHERE prd_end_dt < prd_start_dt

--zoom in cat_id = AC_HE, assume we use only from prd_start_dt since prd_end_dt doest not make sense
-- create a new date fro prd_end_dt before the prd_start_dt
SELECT 
prd_id,
prd_key,
prd_nm,
prd_start_dt,
prd_end_dt,
LEAD (prd_start_dt) OVER (PARTITION BY prd_key ORDER BY prd_start_dt)-1 AS prd_end_dt_test
FROM bronze.crm_prd_info
WHERE prd_key IN ('AC-HE-HL-U509-R', 'AC-HE-HL-U509')


--to include the new prd_end_dt based on prd_start_dt
--to convert prd_start_dt & prd_end_dt from DATE TIME to DATE only since to info on TIME
SELECT
prd_id,
REPLACE (SUBSTRING (prd_key,1,5),'-','_') AS cat_id,
SUBSTRING (prd_key,7, LEN (prd_key)) AS prd_key,
prd_nm,
ISNULL (prd_cost,0) AS prd_cost,
CASE UPPER (TRIM(prd_line))  -- to simplify QUICK CASE for simple value mapping
WHEN 'M' THEN 'Mountain'
WHEN 'R' THEN 'Road'
WHEN 'S' THEN 'Other Sales'
WHEN 'T' THEN 'Touring'
ELSE 'n/a'
END prd_line,
CAST (prd_start_dt AS DATE)  AS prd_start_dt,
CAST (LEAD (prd_start_dt) OVER (PARTITION BY prd_key ORDER BY prd_start_dt)-1 AS DATE) AS prd_end_dt
FROM bronze.crm_prd_info;


-- to update table column on silver.crm_prd_info after data cleaning & standardization from bronze.crm_prd_info

